# MongoDB Connection URI (e.g. from MongoDB Atlas or local mongodb://localhost:27017/online_complaint)
MONGO_URI=mongodb://localhost:27017/online_complaint_box

# Secret key for signing JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Cloudinary Configuration (for uploading profile images and complaint attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Google Maps API Key for location selection
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
